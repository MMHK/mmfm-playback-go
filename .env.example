# MMFM Playback Configuration

# FFmpeg Configuration
FFPLAY_PATH=/usr/bin/ffplay
FFPROBE_PATH=/usr/bin/ffprobe
MPLAYER_PATH=/usr/bin/mplayer

# API Configuration
WEBSOCKET_API=http://localhost:8888
WEB_API=http://localhost:8888/song/get

# Cache Configuration
CACHE_PATH=./cache

# Log Configuration
# LOG_LEVEL: DEBUG / INFO / WARN / ERROR (default: INFO)
LOG_LEVEL=INFO
# LOG_FORMAT: text / json (default: text)
LOG_FORMAT=text
